{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:colors": "node scripts/check-i18n.mjs --colors",
    "check:audit-actions": "node scripts/check-i18n.mjs --audit",
    "check:errcodes": "node scripts/check-i18n.mjs --errcodes",
    "check:errmarkers": "node scripts/check-errmarkers.mjs",
    "check:api-routes": "node scripts/check-api-routes.mjs",
    "check:theme": "node scripts/check-theme-contrast.mjs",
    "check:hardcoded-colors": "node scripts/check-hardcoded-colors.mjs",
    "check:fonts": "node scripts/check-hardcoded-fonts.mjs",
    "check:motion": "node scripts/check-motion.mjs",
    "check:design-tokens": "node scripts/check-design-tokens.mjs",
    "check:icon-titles": "node scripts/check-icon-button-titles.mjs",
    "check:icon-semantics": "node scripts/check-icon-semantics.mjs",
    "icon:report": "node scripts/icon-similarity-report.mjs",
    "check:e2e-conventions": "node scripts/check-e2e-conventions.mjs",
    "check:e2e-dualpath": "node scripts/check-e2e-dualpath.mjs",
    "check:keybindings": "node scripts/check-keybindings.mjs",
    "check:event-names": "node ../scripts/check-event-names.mjs",
    "check:commit": "node ../scripts/check-commit-msg.cjs",
    "test:watch": "vitest",
    "lint": "eslint . --ext .vue,.ts --cache",
    "lint:fix": "eslint . --ext .vue,.ts --fix --cache",
    "check": "vue-tsc --build && npm run lint && vitest run && npm run check:e2e-conventions && npm run check:e2e-dualpath && npm run check:hardcoded-colors && npm run check:fonts && npm run check:motion && npm run check:icon-titles && npm run check:icon-semantics && npm run check:keybindings && npm run check:audit-actions && npm run check:errmarkers && npm run check:errcodes && npm run check:event-names && npm run check:api-routes",
    "check:fast": "vue-tsc --build && npm run lint && node scripts/vitest-changed.mjs && npm run check:e2e-conventions && npm run check:e2e-dualpath && npm run check:hardcoded-colors && npm run check:fonts && npm run check:motion && npm run check:icon-titles && npm run check:icon-semantics && npm run check:keybindings && npm run check:audit-actions && npm run check:errmarkers && npm run check:errcodes && npm run check:event-names && npm run check:api-routes",
    "check:i18n:unused": "node scripts/check-i18n.mjs --unused"
  },
  "dependencies": {
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@vicons/ionicons5": "^0.13.0",
    "@vueuse/core": "^14.3.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.17.0",
    "dompurify": "^3.4.16",
    "marked": "^18.0.5",
    "monaco-editor": "^0.55.1",
    "naive-ui": "^2.44.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.32",
    "vue-i18n": "^11.4.5",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "4.1.8",
    "@vitest/ui": "^4.1.8",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.5.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.12.0",
    "jscpd": "^5.4.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^8.0.4",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.2.6"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.0.3",
    "@rolldown/binding-win32-x64-msvc": "1.0.3",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "lightningcss-win32-x64-msvc": "1.32.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "overrides": {
    "dompurify": "$dompurify"
  }
}
